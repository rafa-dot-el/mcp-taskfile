# shellcheck shell=bash
# devenv CLI comes from the nixpkgs locked in flake.lock (same binary as CI),
# not from whatever devenv the machine has installed.
watch_file flake.lock devenv.nix devenv.yaml devenv.lock
devenv_out="$(nix build --no-link --print-out-paths --inputs-from . nixpkgs#devenv)"
PATH_add "$devenv_out/bin"
eval "$(devenv direnvrc)"
use devenv
